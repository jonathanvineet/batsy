<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Batsy" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:colorAccent">@color/signal</item>
        <item name="android:textColorPrimary">@color/bone</item>
        <item name="android:textColorSecondary">@color/steel</item>
    </style>
    <style name="Pill">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
