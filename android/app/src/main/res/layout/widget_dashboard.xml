<?xml version="1.0" encoding="utf-8"?>
<!-- Batsy dashboard: what Batsy is doing, Claude limits, the laptop and PC, Spotify, and quick buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/card" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="12dp">

    <!-- header: bat, state, route -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_bat"
            android:contentDescription="Batsy" />
        <ImageView android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp"
            android:layout_marginStart="8dp" android:src="@drawable/dot" android:contentDescription="" />
        <TextView android:id="@+id/state" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="Batsy" android:textColor="@color/bone" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/route" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/pill" android:paddingStart="8dp" android:paddingTop="2dp"
            android:paddingEnd="8dp" android:paddingBottom="2dp" android:text="…" android:textColor="@color/steel"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- what it's doing / said last -->
    <TextView android:id="@+id/line_main" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2" android:text=""
        android:textColor="@color/bone" android:textSize="13sp" />
    <TextView android:id="@+id/line_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text=""
        android:textColor="@color/steel" android:textSize="11sp" />

    <!-- Claude limits -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/panel" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="CLAUDE" android:textColor="@color/steel" android:textSize="10sp"
                android:letterSpacing="0.1" android:textStyle="bold" />
            <TextView android:id="@+id/claude_reset" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="" android:textColor="@color/steel_dim"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Session"
                android:textColor="@color/steel" android:textSize="11sp" />
            <ProgressBar android:id="@+id/session_bar" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100"
                android:progressDrawable="@drawable/bar" />
            <TextView android:id="@+id/session_pct" android:layout_width="42dp" android:layout_height="wrap_content"
                android:gravity="end" android:text="–" android:textColor="@color/bone" android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Week"
                android:textColor="@color/steel" android:textSize="11sp" />
            <ProgressBar android:id="@+id/week_bar" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100"
                android:progressDrawable="@drawable/bar" />
            <TextView android:id="@+id/week_pct" android:layout_width="42dp" android:layout_height="wrap_content"
                android:gravity="end" android:text="–" android:textColor="@color/bone" android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- the two machines -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <!-- filled with layout/machine at runtime (each one its own RemoteViews, so their ids don't clash) -->
        <FrameLayout android:id="@+id/m1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" />
        <FrameLayout android:id="@+id/m2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Spotify -->
    <LinearLayout android:id="@+id/music" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:background="@drawable/panel" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="8dp">
        <ImageView android:id="@+id/art" android:layout_width="40dp" android:layout_height="40dp"
            android:scaleType="centerCrop" android:src="@drawable/ic_music" android:contentDescription="Album art" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/song" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="Nothing playing"
                android:textColor="@color/bone" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text=""
                android:textColor="@color/steel" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:id="@+id/btn_prev" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="6dp" android:src="@drawable/ic_prev" android:contentDescription="Previous" />
        <ImageView android:id="@+id/btn_play" android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/pill_accent" android:padding="8dp" android:src="@drawable/ic_play_dark"
            android:contentDescription="Play or pause" />
        <ImageView android:id="@+id/btn_next" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="6dp" android:src="@drawable/ic_next" android:contentDescription="Next" />
    </LinearLayout>

    <!-- buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_stop" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:background="@drawable/pill" android:drawableStart="@drawable/ic_stop"
            android:drawablePadding="4dp" android:gravity="center" android:paddingStart="10dp"
            android:paddingEnd="10dp" android:text="Stop" android:textColor="@color/bone" android:textSize="12sp" />
        <TextView android:id="@+id/btn_wake" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/pill"
            android:drawableStart="@drawable/ic_power" android:drawablePadding="4dp" android:gravity="center"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Wake PC"
            android:textColor="@color/bone" android:textSize="12sp" />
        <TextView android:id="@+id/btn_ask" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/pill"
            android:drawableStart="@drawable/ic_keyboard" android:drawablePadding="4dp" android:gravity="center"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Ask" android:textColor="@color/bone"
            android:textSize="12sp" />
        <ImageView android:id="@+id/btn_refresh" android:layout_width="34dp" android:layout_height="34dp"
            android:layout_marginStart="6dp" android:background="@drawable/pill" android:padding="7dp"
            android:src="@drawable/ic_refresh" android:contentDescription="Refresh" />
    </LinearLayout>
</LinearLayout>
