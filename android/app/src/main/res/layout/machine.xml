<?xml version="1.0" encoding="utf-8"?>
<!-- One machine's stats (the laptop or the PC), used twice in the dashboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/panel" android:orientation="vertical"
    android:paddingStart="10dp" android:paddingTop="8dp" android:paddingEnd="10dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/m_dot" android:layout_width="6dp" android:layout_height="6dp"
            android:src="@drawable/dot" android:contentDescription="" />
        <TextView android:id="@+id/m_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="Laptop" android:textColor="@color/bone" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/m_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/steel" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="CPU"
            android:textColor="@color/steel" android:textSize="10sp" />
        <ProgressBar android:id="@+id/m_cpu_bar" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:max="100"
            android:progressDrawable="@drawable/bar" />
        <TextView android:id="@+id/m_cpu" android:layout_width="34dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="–" android:textColor="@color/bone" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="RAM"
            android:textColor="@color/steel" android:textSize="10sp" />
        <ProgressBar android:id="@+id/m_ram_bar" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:max="100"
            android:progressDrawable="@drawable/bar" />
        <TextView android:id="@+id/m_ram" android:layout_width="34dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="–" android:textColor="@color/bone" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/m_extra" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text=""
        android:textColor="@color/steel" android:textSize="10sp" />
</LinearLayout>
