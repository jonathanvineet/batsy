{
  "manifest_version": 3,
  "name": "Batsy",
  "version": "1.0",
  "description": "Lets Batsy know what you're looking at, and keep track of, ask about or save the page you're on.",
  "icons": {"128": "icon.png"},
  "action": {"default_popup": "popup.html", "default_icon": "icon.png"},
  "background": {"service_worker": "background.js"},
  "permissions": ["tabs", "storage", "contextMenus", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://100.117.229.111:8765/*", "https://workstation.taila566eb.ts.net/*"]
}
